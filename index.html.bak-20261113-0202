<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>ComfyUI Prompt Studio</title>
  <link rel="stylesheet" href="./styles.css?v=20261112-ux-1">
<script>try{localStorage.setItem('promptStudio.detailsView.v1','true');}catch(e){}</script></head>
<body class="light details-mode">
  <div class="app-shell">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">P</div>
        <div>
          <strong>Prompt Studio</strong>
          <span>ComfyUI 本地提示词工作台</span>
        </div>
      </div>
      <div class="topbar-actions">
        <span class="status-pill"><i></i>完全离线</span>
        <span class="status-pill muted" id="saveStatus" role="status">本地自动保存</span>
        <button class="icon-button" id="themeButton" type="button" title="切换主题">◐</button>
        <button class="icon-button" id="helpButton" type="button" title="使用说明">?</button>
      </div>
    </header>

    <main class="main-grid">
      <aside class="side-rail" id="sideRail" aria-label="工作区导航">
        <div class="side-rail-tabs" role="tablist" aria-label="工作区视图" aria-orientation="vertical">
          <span class="workspace-tab-thumb" aria-hidden="true"></span>
          <button class="rail-item is-active" id="quickViewTab" type="button" role="tab" aria-selected="true">
            <span class="rail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l3 3L4 13"/><path d="M11 5h7"/><path d="M11 11h7"/><path d="M11 17h7"/></svg>
            </span>
            <span class="rail-label">快速预设</span>
          </button>
          <button class="rail-item" id="detailViewTab" type="button" role="tab" aria-selected="false">
            <span class="rail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h11"/><path d="M9 10h11"/><path d="M9 16h11"/><path d="M4 4h.01"/><path d="M4 10h.01"/><path d="M4 16h.01"/></svg>
            </span>
            <span class="rail-label">详细设置</span>
          </button>
        </div>
        <div class="side-rail-utils">
          <button class="rail-item rail-util rail-reset" id="resetButton" type="button" title="恢复初始选项">
            <span class="rail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 2.6-6.3"/><path d="M3 4v5h5"/></svg>
            </span>
            <span class="rail-label">重置全部</span>
          </button>
        </div>
      </aside>
      <section class="workspace">
        <p id="modelSummary" class="sr-only" aria-hidden="true"></p>
        <div class="top-stack">
          <section class="command-bar" id="section-sentence">
          <div class="cmd-main" id="cmdMain">
            <input id="sentenceInput" type="text" autocomplete="off" spellcheck="false" placeholder="描述画面，先预览确定选项（本地匹配，不自动翻译）">
            <button class="button primary" id="sentenceButton" type="button">预览识别</button>
          </div>
          <div class="cmd-side">
            <div class="cmd-group content-scale-group">
              <span class="cmd-label">内容尺度 <button class="icon-button tiny" id="scaleLockButton" type="button" title="锁定尺度，防止误切" aria-pressed="false">锁定</button></span>
              <div class="scale-switch" id="scaleSwitch" role="group" aria-label="内容尺度">
                <button type="button" data-scale="sfw" aria-pressed="true">日常</button>
                <button type="button" data-scale="suggestive" aria-pressed="false">暗示</button>
                <button type="button" data-scale="boudoir" aria-pressed="false">私房</button>
                <button type="button" data-scale="adult" aria-pressed="false">开放</button>
                <button type="button" data-scale="revealing" aria-pressed="false">露点</button>
              </div>
            </div>
            <input type="hidden" id="contentScale" data-state value="sfw">
            <label class="cmd-group random-inline-setting">
              <span class="cmd-label" title="锁定后随机不会改变画幅">画幅锁定</span>
              <select class="random-scope" id="ratioLock" data-state aria-label="画幅锁定">
                <option value="">不锁定</option>
                <option value="aspect ratio 1:1">1:1 方形</option>
                <option value="aspect ratio 4:5, vertical portrait">4:5 竖版</option>
                <option value="aspect ratio 3:2, horizontal photography">3:2 横向</option>
                <option value="aspect ratio 16:9, cinematic widescreen">16:9 横向</option>
                <option value="aspect ratio 9:16, vertical short video">9:16 竖屏</option>
                <option value="aspect ratio 2.39:1, anamorphic widescreen">2.39:1 宽银幕</option>
              </select>
            </label>
            
          </div>
          <section class="quick-look-bar" id="quickLookBar" aria-label="人物风格、搭配与镜头快捷设置">
            <div class="quick-look-fields quick-look-primary">
              <label class="quick-look-field quick-style-field">
                <span>人物风格 <button class="text-button" id="clearStyleButton" type="button" title="清除当前人物风格">清除</button></span>
                <div class="quick-style-select-row">
                  <select id="stylePreset" data-state></select>
                  <button class="icon-button style-inspire-button" id="styleInspireButton" type="button" title="风格灵感：点卡片直接套用，Alt+单击仅选入" aria-haspopup="true" aria-expanded="false">✦</button>
                </div>
                <div class="style-inspire-pop" id="styleInspirePop" hidden>
                  <div class="style-inspire-pop-head">
                    <strong>风格灵感</strong>
                    <small>点卡片直接套用；Alt+单击仅选入顶部</small>
                    <span class="quick-extras-count" id="quickExtrasCount"></span>
                  </div>
                  <div class="quick-style-chips" id="quickStyleChips"></div>
                </div>
              </label>
              <label class="quick-look-field">
                <span>着装</span>
                <select id="topOutfitState">
                  <option value="dressed">穿衣</option>
                  <option value="half-nude">半裸</option>
                  <option value="nude">全裸</option>
                </select>
              </label>
              <label class="quick-look-field">
                <span>整体风格</span>
                <select id="topVisualStyle"></select>
              </label>
              <label class="quick-look-field">
                <span>镜头方案</span>
                <select id="cameraPlanQuick"></select>
              </label>
            </div>
            <details class="quick-more" id="quickMore">
              <summary>更多 3 项<span>地域 · 年龄 · 预设服装</span></summary>
              <div class="quick-look-fields quick-look-secondary">
                <label class="quick-look-field">
                  <span>地域外观参考</span>
                  <select id="topPerson">
                    <option value="">不指定</option>
                    <option value="Chinese regional facial features">中国</option>
                    <option value="East Asian features">东亚其他</option>
                    <option value="Japanese and Korean features">日韩</option>
                    <option value="Southeast Asian features">东南亚</option>
                    <option value="South Asian features">南亚</option>
                    <option value="Central Asian features">中亚</option>
                    <option value="Turkish and West Asian features">西亚与中东</option>
                    <option value="European features">欧洲</option>
                    <option value="African features">非洲</option>
                    <option value="Latin American features">拉美</option>
                    <option value="Indigenous American features">美洲原住民</option>
                    <option value="Pacific Islander features">太平洋岛民</option>
                    <option value="Eurasian mixed features">欧亚混血</option>
                    <option value="Afro-European mixed features">非欧混血</option>
                    <option value="mixed-heritage features">多地域混合</option>
                  </select>
                </label>
                <label class="quick-look-field quick-look-age">
                  <span>年龄</span>
                  <select id="topAge"></select>
                </label>
                <label class="quick-look-field">
                  <span>预设服装</span>
                  <select id="styleLook" data-state></select>
                </label>
              </div>
            </details>
            <div class="quick-look-actions">
              <div class="quick-look-actions-secondary">
                <button class="button secondary small" id="randomButton" type="button" title="只重抽顶部的人物、风格、造型和镜头，其他字段不动">换一套风格</button>
                <button class="button secondary small" id="quickCopyPrompt" type="button">复制英文提示词</button>
                <button class="icon-button" id="undoButton" type="button" disabled title="撤销上一次套用或随机">↺</button>
                <button class="text-button danger" id="deleteStylePresetButton" type="button">删除</button>
                <button class="text-button" id="quickGoDetail" type="button">去详细设置</button>
              </div>
            </div>
            <div class="quick-look-summary" id="quickLookSummary"></div>
          </section>
          <section class="reveal-quick-panel" id="revealQuickPanel" aria-label="露点场景与露出重点" hidden>
            <div class="reveal-quick-heading">
              <div>
                <strong>露点方案</strong>
                <small id="revealQuickHint">场景与露出重点只做预览，点击“套用当前”后一次性生效。</small>
              </div>
              <button class="text-button" id="randomRevealScenarioButton" type="button">随机露点方案</button>
            </div>
            <div class="quick-reveal-chips" id="quickRevealChips"></div>
            <div class="reveal-quick-fields">
              <label class="quick-look-field">
                <span>表现强度</span>
                <select id="revealIntensityQuick" data-state></select>
              </label>
              <label class="quick-look-field">
                <span>露出重点</span>
                <select id="revealTargetQuick" data-state></select>
              </label>
              <label class="quick-look-field">
                <span>场景套餐</span>
                <select id="revealScenarioQuick" data-state></select>
              </label>
              <label class="quick-look-field">
                <span>姿势预设</span>
                <select id="revealPoseQuick" data-state></select>
              </label>
              <label class="quick-look-field">
                <span>成人道具</span>
                <select id="adultPropQuick" data-state></select>
              </label>
            </div>
            <div class="reveal-quick-actions">
              <button class="button secondary small" id="rerollRevealPoseButton" type="button">换姿势</button>
              <button class="button secondary small" id="rerollRevealCameraButton" type="button">换镜头</button>
              <button class="button secondary small" id="rerollAdultPropButton" type="button">换道具</button>
              <button class="button ghost small" id="clearAdultPropButton" type="button">清除道具</button>
            </div>
            <div class="reveal-empty-state" id="revealEmptyState" role="status" hidden>
              <span id="revealEmptyText">当前筛选没有可用露点方案。</span>
              <button class="text-button" id="revealResetFiltersButton" type="button">查看全部</button>
            </div>
          </section>
          <div class="quick-apply-primary" id="quickApplyBar">
            <label class="quick-apply-mode">
              <span class="sr-only">套用范围</span>
              <select id="styleApplyMode" title="套用+随机：套用顶层已选项，其余字段随机">
                <option value="random-rest" selected>套用+随机</option>
                <option value="full">整套造型</option>
                <option value="makeup">只应用妆发</option>
                <option value="fill">只补未选择项</option>
              </select>
            </label>
            <button class="button primary" id="applyQuickButton" type="button">套用当前</button>
          </div>
          <div class="workspace-mode-row">
            <div class="detail-preset-bar" id="detailPresetBar">
              <label class="detail-scale-inline">
                <span>尺度</span>
                <select id="detailScale">
                  <option value="sfw">日常</option>
                  <option value="suggestive">暗示</option>
                  <option value="boudoir">私房</option>
                  <option value="adult">开放</option>
                  <option value="revealing">露点</option>
                </select>
              </label>
              <button class="icon-button tiny" id="detailScaleLockButton" type="button" title="锁定尺度，防止误切" aria-pressed="false">锁定</button>
              <button class="button secondary small" id="detailPresetToggle" type="button">展开预设</button>
              <span class="detail-preset-summary" id="detailPresetSummary"></span>
              <button class="text-button" id="detailResetButton" type="button">重置</button>
            </div>
            
          </div>
          <div class="sentence-empty" id="sentenceEmpty" hidden>没有足够明确的匹配，未修改任何设置。原句已保留；请在详细设置手动选择，或填写自定义中英文描述。</div>
          <div class="sentence-result" id="sentenceResult" hidden>
            <div class="sentence-head">
              <span id="sentenceSummary"></span>
              <button class="text-button" id="sentenceUndo" type="button">撤销本次解析</button>
            </div>
            <div class="sentence-chips" id="sentenceChips"></div><p id="sentenceCoverage" class="ux-note"></p><button class="button secondary small" id="sentenceApply" type="button" disabled>应用已识别选项</button>
          </div>
          </section>

          <div class="wizard-bar">
            <div class="wizard-nav-row">
              <span class="wizard-nav-label">流程</span>
              <div class="wizard-steps" id="wizardSteps" role="tablist" aria-label="步骤"></div>
            </div>
            <div class="wizard-nav-row wizard-category-row">
              <span class="wizard-nav-label">本步</span>
              <div class="wizard-category-group">
                <div class="wizard-categories" id="wizardCategories" role="tablist" aria-label="当前步骤分类"></div>
              </div>
            </div>
            <div class="wizard-status-row">
              <span class="wizard-nav-label">状态</span>
              <div class="wizard-check" id="wizardCheck" role="status" aria-live="polite"></div>
            </div>
          </div>
        </div>

        <section class="form-card is-active" id="section-model">
          <div class="card-heading">
            <div class="step-number">01</div>
            <div>
              <h2>模型与输出</h2>
              <p>切换模型后，提示词会自动采用对应结构。</p>
            </div>
            <span class="mode-badge" id="modeBadge">图像</span>
          </div>

          <div class="control-grid cols-3">
            <label class="field wide">
              <span>目标模型</span>
              <select id="model" data-state></select>
              <small id="modelHint"></small>
            </label>
            <label class="field custom-only" id="customModelWrap">
              <span>自定义模型名称</span>
              <input id="customModelName" data-state type="text" placeholder="例如我的定制模型">
            </label>
            <label class="field custom-only" id="customFormatWrap">
              <span>输出结构</span>
              <select id="customFormat" data-state>
                <option value="natural">自然语言</option>
                <option value="tags">标签流</option>
                <option value="h3">连续镜头时间轴</option>
                <option value="i2v">图生视频</option>
              </select>
            </label>
            <label class="field">
              <span>输出方式</span>
              <input type="text" value="英文主提示词 + 中文参考（自定义需分别填写）" readonly>
              <small>英文用于 ComfyUI 复制，中文用于阅读和校对；LoRA 触发词保持原文。</small>
            </label>
            <input type="hidden" id="language" data-state value="en">
            <label class="field">
              <span>细节程度</span>
              <select id="detailLevel" data-state>
                <option value="balanced">平衡</option>
                <option value="concise">精简</option>
                <option value="cinematic">电影级详细</option>
              </select>
            </label>
            <label class="field">
              <span>画面比例</span>
              <select id="aspectRatio" data-state></select>
            </label>
            <label class="field wide">
              <span>画面尺寸（像素）</span>
              <div class="size-row">
                <select id="sizePreset"></select>
                <input id="imageWidth" data-state type="number" min="256" max="4096" step="8" inputmode="numeric" aria-label="宽度">
                <span class="size-x">×</span>
                <input id="imageHeight" data-state type="number" min="256" max="4096" step="8" inputmode="numeric" aria-label="高度">
              </div>
              <small id="sizeHint"></small>
            </label>
            <label class="field wide">
              <span>LoRA 触发词</span>
              <input id="loraTrigger" data-state type="text" placeholder="填写当前 LoRA 的触发词，可留空">
              <small id="loraTriggerHint">只填触发词；LoRA 权重请在 ComfyUI 的 LoRA Loader 中控制，建议从 0.7–0.9 开始测试。</small>
            </label>
            <label class="switch-row compact-switch lora-direct-toggle">
              <span>
                <strong>LoRA 直出</strong>
                <small>只精简默认描述；你主动选择的袜类材质、鞋履、配饰、表情和图案等细节仍会保留。</small>
              </span>
              <input type="checkbox" id="loraDirect" data-state>
            </label>
            <div class="adult-layer-panel" id="adultLayerWrap" hidden>
              <label class="field wide">
                <span>开放附加层</span>
                <select id="adultLayer" data-state></select>
                <small>独立于普通提示词，只在“开放”且开启 LoRA 直出时使用。</small>
              </label>
            </div>
            <div class="lora-ui" hidden>
              <div class="lora-box">
                <div class="lora-head">
                  <span id="loraSummary">我的 LoRA 清单</span>
                  <span class="lora-head-actions">
                    <button class="text-button" id="loraPaste" type="button">批量粘贴</button>
                    <button class="text-button" id="loraAdd" type="button">＋ 添加</button>
                  </span>
                </div>
                <div class="lora-list" id="loraList"></div>
                <div class="lora-paste" id="loraPasteBox" hidden>
                  <textarea id="loraPasteText" rows="5" placeholder="每行一条，支持这三种写法：&#10;触发词&#10;触发词, 0.8&#10;名称, 触发词, 0.8"></textarea>
                  <div class="lora-paste-actions">
                    <button class="button primary" id="loraPasteSave" type="button">解析并加入</button>
                    <button class="button ghost" id="loraPasteCancel" type="button">取消</button>
                  </div>
                </div>
                <div class="lora-form" id="loraForm" hidden>
                  <input id="loraName" type="text" placeholder="名称（可留空，只给自己看）">
                  <input id="loraTriggerInput" type="text" placeholder="触发词，例如 moss_xvstyle">
                  <input id="loraWeight" type="number" min="0.1" max="2" step="0.05" value="0.8" title="权重（只写进 JSON，不写进提示词）">
                  <button class="button primary" id="loraSave" type="button">保存</button>
                  <button class="button ghost" id="loraCancel" type="button">取消</button>
                </div>
                <div class="lora-actions">
                  <button class="text-button" id="loraExport" type="button">导出清单</button>
                  <button class="text-button" id="loraImport" type="button">导入清单</button>
                  <input id="loraImportFile" type="file" accept="application/json" hidden>
                  <small>先只勾一个主 LoRA 做基准，再添加第二个；不兼容当前底模的项目会自动禁用。</small>
                </div>
              </div>
            </div>
          </div>

          <div class="notice" id="modelNotice"></div>
        </section>

        <section class="form-card" id="section-character">
          <div class="card-heading">
            <div class="step-number">02</div>
            <div>
              <h2>角色与外观</h2>
              <p>人物选项默认限制为成年虚构角色，避免身份和年龄歧义。</p>
            </div>
            <span class="mini-badge">成年安全</span>
          </div>

          <div class="anatomy-gate" id="pubicGate" style="display: none">
            <div>
              <strong id="pubicGateTitle">下体细节暂不可选</strong>
              <small id="pubicGateReason">需要先让下体在当前画面中实际可见。</small>
            </div>
            <button class="button secondary small" id="pubicGateButton" type="button">补齐显示条件</button>
          </div>

          <div class="control-grid cols-3">
            <label class="field">
              <span>主体类型</span>
              <select id="subjectType" data-state>
                <option value="person">单个人物</option>
                <option value="couple">双人角色</option>
                <option value="group">小群像</option>
                <option value="creature">奇幻生物</option>
                <option value="object">产品 / 物体</option>
              </select>
            </label>
            <label class="field">
              <span>关系构成</span>
              <select id="relationshipType" data-state></select>
            </label>
            <label class="field">
              <span>画面重点</span>
              <select id="visualEmphasis" data-state></select>
            </label>
            <label class="field multi-only">
              <span>关系气质</span>
              <select id="relationshipDynamic" data-state></select>
            </label>
            <label class="field">
              <span>角色预设</span>
              <select id="rolePreset" data-state></select>
              <small>按职业、礼服、居家和双人关系分组；应用后会覆盖对应字段，仍可逐项修改。</small>
            </label>
            <label class="field">
              <span>人物构成总览</span>
              <select id="gender" data-state disabled></select>
              <small>由关系构成自动生成，只用于总人数与性别总览。</small>
            </label>
            <label class="field">
              <span>角色 A · 性别呈现</span>
              <select id="firstGender" data-state></select>
            </label>
            <label class="field">
              <span>角色 A · 年龄感</span>
              <select id="age" data-state></select>
            </label>
            <label class="field">
              <span>角色 A · 外貌取向</span>
              <select id="appearance" data-state></select>
            </label>
            <label class="field multi-only">
              <span>角色 A · 画面位置</span>
              <select id="firstPosition" data-state></select>
            </label>
            <label class="field">
              <span>角色 A · 体型</span>
              <select id="body" data-state></select>
            </label>
            <label class="field">
              <span>角色 A · 身高感</span>
              <select id="heightPresence" data-state></select>
