  let revealRandomHistory = null;

  function revealRandomHistoryState() {
    if (!revealRandomHistory) {
      const saved = storageGet("promptStudio.revealRandomHistory.v1", {});
      revealRandomHistory = saved && typeof saved === "object" ? saved : {};
    }
    return revealRandomHistory;
  }

  function pickFreshRandom(items, type, keySelector, cooldown = 4) {
    if (!items.length) return null;
    const history = revealRandomHistoryState();
    const recent = Array.isArray(history[type]) ? history[type] : [];
    const blocked = new Set(recent.slice(-cooldown));
    const fresh = items.filter((item) => !blocked.has(keySelector(item)));
    const pool = fresh.length ? fresh : items;
    const picked = pool[Math.floor(Math.random() * pool.length)];
    const key = keySelector(picked);
    history[type] = [...recent, key].slice(-12);
    storageSet("promptStudio.revealRandomHistory.v1", history);
    return picked;
  }

  function randomizeRevealScenario() {
    const target = $("revealTargetQuick")?.value || "all";
    const intensity = $("revealIntensityQuick")?.value || "all";
    const scenarios = (REVEAL_SCENARIOS || [])
      .filter(revealScenarioCompatible)
      .filter((item) => target === "all" || item.target === target)
      .filter((item) => intensity === "all" || revealScenarioIntensity(item) === intensity);
    if (!scenarios.length) {
      showToast("当前人物或露出重点没有可用露点方案");
      return;
    }
    const picked = pickFreshRandom(scenarios, "scenario", (item) => item.key, 4);
    chooseRevealScenario(picked.key);
    const poses = (REVEAL_POSES || []).filter(revealPoseCompatible);
    if (poses.length) {
      const pose = pickFreshRandom(poses, "pose", (item) => item.key, 3);
      setSelectValue("revealPoseQuick", pose.key);
    }
    const props = (O.adultProp || []).filter((item) => item.en && revealPropCompatible(item));
    setSelectValue("adultPropQuick", props.length && Math.random() < 0.45
      ? pickFreshRandom(props, "prop", (item) => item.en, 5).en
      : "");
    updateQuickLookSummary();
    saveAutosave();
  }

