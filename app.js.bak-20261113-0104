    [/collarbone|neckline|neck |肩颈|锁骨|颈部/, ["neck", "shoulderTorso", "fullBody"]],
    [/shoulder|上胸|肩线|肩膀/, ["shoulderTorso", "neck", "fullBody"]],
    [/calf|ankle|小腿|脚踝/, ["calfAnkle", "outerThigh", "fullBody"]],
    [/leg|legs|腿部|双腿|直腿|屈膝/, ["outerThigh", "innerThighKnee", "fullBody"]],
    [/face|jaw|chin|lip|cheek|lash|bangs|面部|下颌|嘴唇|脸颊|下巴/, ["face", "neck", "fullBody"]],
    [/hand|hands|finger|arm|wrist|手部|指尖|手臂|双手/, ["handsArms", "shoulderTorso", "fullBody"]],
  ];

  function selectedTemplateItem(field) {
    const value = $(field)?.value || "";
    return rawOptionPairs(field).find((option) => option.en === value) || null;
  }

  function selectedTemplateText(field) {
    const item = selectedTemplateItem(field);
    return item ? `${item.zh} ${item.en}`.toLowerCase() : "";
  }

  function allowedBodyFocusValues() {
    return new Set(getOptionPairs("bodyFocus").map((item) => item.en));
  }

  function templateFocusCodes(field, allowFallback = true) {
    const item = selectedTemplateItem(field);
    if (Array.isArray(item?.focus) && item.focus.length) return item.focus;
    const text = selectedTemplateText(field);
    if (!text) return [];
    const rule = BODY_FOCUS_RULES.find(([pattern]) => pattern.test(text));
    if (!rule && !allowFallback) return [];
    return rule ? rule[1] : ["fullBody"];
  }

  function applyTemplateBodyFocus(field) {
    if (!["pose", "action"].includes(field)) return;
    const candidates = templateFocusCodes(field, field === "pose");
    if (!candidates.length) return;
    const allowed = allowedBodyFocusValues();
    const values = candidates
      .map((key) => BODY_FOCUS_VALUES[key])
      .filter((value, index, list) => value && allowed.has(value) && list.indexOf(value) === index);
    if (!values.length) return;
    setSelectValue("bodyFocus", values[0]);
    if (field === "pose") {
      setSelectValue("bodyFocusSecondary", values[1] || "");
      setSelectValue("bodyFocusTertiary", values[2] || "");
    }
  }

  function normalizeCharacterFocus() {
    const type = currentSubjectType();
    const fields = ["bodyFocus", "bodyFocusSecondary", "bodyFocusTertiary"];
    let fixes = 0;

    if (type === "person") {
      for (const field of fields.slice(1)) {
        if ($(field)?.value) {
          clearSelectValue(field);
          fixes += 1;
        }
      }
      return fixes;
    }

    const expected = type === "group" ? 3 : 2;
    const allowed = new Set(
      getOptionPairs("bodyFocus")
        .filter((item) => item.en)
        .map((item) => item.en)
    );
    const preferred = templateFocusCodes("pose")
      .map((code) => BODY_FOCUS_VALUES[code])
      .filter((value) => value && allowed.has(value));
    const fallback = [...allowed];
    const candidates = [...new Set([...preferred, ...fallback])];
    const used = new Set();

    for (let index = 0; index < expected; index += 1) {
      const field = fields[index];
      const current = $(field)?.value || "";
      let next = current && allowed.has(current) && !used.has(current) ? current : "";
      if (!next) next = candidates.find((value) => !used.has(value)) || "";
      if (next && next !== current) {
        setSelectValue(field, next);
        fixes += 1;
      }
      if (next) used.add(next);
    }
    for (const field of fields.slice(expected)) {
      if ($(field)?.value) {
        clearSelectValue(field);
        fixes += 1;
      }
    }
    return fixes;
  }

  function normalizeCharacterPositions() {
    const type = currentSubjectType();
    const fields = ["firstPosition", "secondPosition", "thirdPosition"];
    if (type === "person") {
      let fixes = 0;
      for (const field of fields) {
        if ($(field)?.value) {
          clearSelectValue(field);
          fixes += 1;
        }
      }
      return fixes;
    }

    const defaults = ["left foreground", "right midground", "center background"];
    const expected = type === "group" ? 3 : 2;
    const used = new Set();
    let fixes = 0;
    for (let index = 0; index < expected; index += 1) {
      const field = fields[index];
      const allowed = new Set(getOptionPairs(field).filter((item) => item.en).map((item) => item.en));
      const current = $(field)?.value || "";
      let next = current && allowed.has(current) && !used.has(current) ? current : "";
      if (!next) next = allowed.has(defaults[index]) ? defaults[index] : [...allowed].find((value) => !used.has(value)) || "";
      if (next && next !== current) {
        setSelectValue(field, next);
        fixes += 1;
      }
      if (next) used.add(next);
    }
    for (const field of fields.slice(expected)) {
      if ($(field)?.value) {
        clearSelectValue(field);
        fixes += 1;
      }
    }
    return fixes;
  }

  function roleForCharacterField(field) {
    if (field.startsWith("third")) return "third";
    if (field.startsWith("second")) return "second";
    return "first";
  }

  function characterFieldCompatible(field, item, role) {
    if (!item?.en || !roleExists(role)) return true;
    const group = item.group || "";
    const text = `${item.zh || ""} ${item.en || ""}`.toLowerCase();
    if (["outfit", "secondOutfit", "thirdOutfit"].includes(field)) {
      if (roleIsMale(role)) {
        return (
          !group ||
          MALE_OUTFIT_GROUPS.has(group) ||
          NEUTRAL_OUTFIT_GROUPS.has(group)
        ) && !MALE_INCOMPATIBLE_OUTFIT.test(text);
      }
      if (roleIsFemale(role)) {
        return !MALE_OUTFIT_GROUPS.has(group) && group !== "男性泳装与内裤" && group !== "男性运动";
      }
    }
    if (["coveredGarment", "secondCoveredGarment", "thirdCoveredGarment"].includes(field)) {
      if (roleIsMale(role)) {
        return group !== "情趣内衣" && (
          group === "男性遮盖" ||
          (!group && !MALE_INCOMPATIBLE_OUTFIT.test(text))
        );
      }
      if (roleIsFemale(role)) {
        return group !== "男性遮盖" && !/\bmen's\b|男士/.test(text);
      }
    }
    if (["footwear", "secondFootwear", "thirdFootwear"].includes(field) && roleIsMale(role)) {
      return group !== "高跟鞋" && !MALE_INCOMPATIBLE_FOOTWEAR.test(text);
    }
    if (["hosiery", "secondHosiery", "thirdHosiery"].includes(field) && roleIsMale(role)) {
      return MALE_HOSIERY.has(item.en);
    }
    if (field === "grooming" && roleIsMale(role)) {
      return MALE_GROOMING.has(item.en);
    }
    if (["accessories", "secondAccessories", "thirdAccessories"].includes(field) && roleIsMale(role)) {
      return MALE_ACCESSORIES.has(item.en);
    }
    return true;
  }

  function getOptionPairs(field) {
    const key = FIELD_TO_OPTIONS[field];
    const list = O[key] || [];
    const mergeKey = ADULT_OPTION_MERGES[field];
    const merged = mergeKey ? [...list, ...(O[mergeKey] || []).filter((item) => item.en)] : list;
    const unique = [...new Map(merged.map((item) => [item.en.toLowerCase(), item])).values()];
    if (/^(second|third)/.test(field) && !unique.some((item) => !item.en)) {
      unique.unshift(pair("不指定", ""));
    }
    const type = currentSubjectType();
    const limit = subjectPeopleLimit();
    let fits = unique.filter((item) => (item.people || 1) <= limit);
    if (itemHasRelationshipTags(fits) && currentRelationshipKey()) {
      fits = fits.filter((item) =>
        !item.relationships || item.relationships.includes(currentRelationshipKey())
      );
    }
    if (field === "pose" && isAdultScale() && type !== "person") {
      const exactGroup = fits.filter((item) => (item.people || 1) === limit);
      if (exactGroup.length) fits = exactGroup;
    }
    fits = fits.filter((item) => optionAllowedAtCurrentScale(item, field));
    if (field === "coveredGarment") {
      const coverage = rawOptionPairs("halfNudeStyle").find((item) => item.en === $("halfNudeStyle")?.value);
      const zone = coverage?.zone || "";
      const opacity = $("coveredOpacity")?.value || "";
      fits = fits.filter((item) =>
        (zone === "lingerie"
          ? !item.en || isLingerieItem(item)
          : !item.zones || item.zones.includes(zone)) &&
        (!item.opacities || item.opacities.includes(opacity))
      );
    }
    if (field === "outfitMode") {
      const state = $("outfitState")?.value || "dressed";
      fits = fits.filter((item) =>
        !item.en ||
        (state === "nude" ? item.en === "fully nude" : item.en !== "fully nude")
      );
    }
    if (["secondCoveredGarment", "thirdCoveredGarment"].includes(field)) {
      const role = roleForCharacterField(field);
      const coverage = rawOptionPairs(roleFieldId("halfNudeStyle", role))
        .find((item) => item.en === $(roleFieldId("halfNudeStyle", role))?.value);
      const zone = coverage?.zone || "";
      const opacity = $(roleFieldId("coveredOpacity", role))?.value || "";
      fits = fits.filter((item) =>
        (zone === "lingerie"
          ? !item.en || isLingerieItem(item)
          : !item.zones || item.zones.includes(zone)) &&
        (!item.opacities || item.opacities.includes(opacity))
      );
    }
    if (["coveredMaterial", "secondCoveredMaterial", "thirdCoveredMaterial"].includes(field)) {
      const role = roleForCharacterField(field);
      const opacity = $(roleFieldId("coveredOpacity", role))?.value || "";
      fits = fits.filter((item) => !item.opacities || item.opacities.includes(opacity));
    }
    const halfNudeMode = $("outfitMode")?.value === "half-nude styling";
    const lingerie = selectedRawItem("coveredGarment");
    const hosiery = selectedRawItem("hosiery");
    if (halfNudeMode && field === "hosiery" && isLingerieItem(lingerie)) {
      fits = fits.filter((item) => !item.en || lingerieHosieryCompatible(lingerie, item));
    }
    if (halfNudeMode && field === "coveredGarment" && hosiery) {
      fits = fits.filter((item) =>
        !item.en || !isLingerieItem(item) || lingerieHosieryCompatible(item, hosiery)
      );
    }
    if (halfNudeMode && field === "hosieryTop") {
      fits = fits.filter((item) => !item.en || hosieryTopCompatible(lingerie, hosiery, item.en));
    }
    if (HOSIERY_DETAIL_FIELDS.has(field)) {
      const style = selectedRawItem("hosiery");
      if (!style || !hosieryFieldAvailable(field)) {
        fits = fits.filter((item) => !item.en);
      } else if (field === "hosieryTop") {
        fits = fits.filter((item) => !item.en || hosieryTopAllowedForStyle(style, item.en));
      }
    }
    if (field === "revealMode") {
      const skirtReady = skirtPresentationAvailable();
      fits = fits.filter((item) =>
        !item.en ||
        revealTargetAllowed(item) &&
        (item.mode !== "skirt" || skirtReady)
      );
    }
    if (field === "revealAction") {
      const modeItem = selectedRevealModeItem();
      const mode = modeItem?.mode || "";
      const target = modeItem?.target || "";
      fits = mode
        ? fits.filter((item) =>
            !item.en ||
            (
              item.modes?.includes(mode) &&
              (!target || !item.targets || item.targets.includes(target)) &&
              ($("outfitMode")?.value !== "fully nude" || !revealActionRequiresGarment(item))
            )
          )
        : fits.filter((item) => !item.en);
    }
    if (field === "underwearStyle" && !underwearAvailable()) {
      fits = fits.filter((item) => !item.en);
    }
    if (field === "cameraPlan") {
      fits = fits.filter((item) => !item.en || cameraPlanCompatible(item));
    }
    if (field === "styleLook") {
      const styleKey = $("stylePreset")?.value || "";
      fits = fits.filter((item) =>
        !item.en ||
        item.en === "custom style look" ||
        item.styleKey === styleKey
      );
    }
    if ((CHEST_FORM_FIELDS.has(field) || NIPPLE_FIELDS.has(field) || PUBIC_FIELDS.has(field) || VULVA_FIELDS.has(field)) &&
        !anatomyFieldVisible(field)) {
      fits = fits.filter((item) => !item.en);
    }
    if (MALE_ANATOMY_FIELDS.has(field) && !anatomyFieldVisible(field)) {
      fits = fits.filter((item) => !item.en);
    }
    if (field === "garmentGraphicZone" && $("outfitMode")?.value === "half-nude styling") {
      const garment = O.coveredGarment.find((item) => item.en === $("coveredGarment")?.value);
      const zones = garment?.zones || [];
      fits = fits.filter((item) => !item.zones || item.zones.some((zone) => zones.includes(zone)));
    }
    // 双人主体时，性别只保留“成对”选项，避免拼出一个人的描述
    if (field === "gender" && type === "couple") {
      const pairOnly = fits.filter((item) => item.people === 2);
      if (pairOnly.length) fits = pairOnly;
    }
    if (field === "gender" && type === "group") {
      const groupOnly = fits.filter((item) => item.people === 3);
      if (groupOnly.length) fits = groupOnly;
    }
    // 成人向条目不隐藏，只是排到最后并归入「成人向 · 18+」分组
    const role = roleForCharacterField(field);
    fits = fits.filter((item) => characterFieldCompatible(field, item, role));
    return [...fits.filter((item) => !item.adultOnly), ...fits.filter((item) => item.adultOnly)];
  }

  // 主体类型变了，所有下拉要重算（原来能选的“成对”选项要消失）
