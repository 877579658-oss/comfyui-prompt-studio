        }
        const remaining = adult.filter((item) => !order.includes(item.group || ""));
        if (remaining.length) {
          const group = document.createElement("optgroup");
          group.label = adultGroupLabel();
          for (const item of remaining) addOption(group, item, true);
          select.append(group);
        }
        return;
      }
      if (id === "coveredGarment") {
        const order = ["", "内衣套装", "连体衣", "束腰胸衣", "睡袍套装", "吊带袜套装", "特殊结构", "古风情趣", "男性遮盖", "其他"];
        for (const styleGroup of order) {
          const items = adult.filter((item) => (item.styleGroup || (item.en ? "其他" : "")) === styleGroup);
          if (!items.length) continue;
          const group = document.createElement("optgroup");
          group.label = styleGroup
            ? `${adultGroupLabel()} · ${styleGroup}`
            : adultGroupLabel();
          for (const item of items) addOption(group, item, true);
          select.append(group);
