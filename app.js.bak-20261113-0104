  async function importBackup(file) {
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      if (!data || (!data.saved && !data.history && !data.loras && !data.stylePresets && !data.state)) {
        showToast("这不是完整备份文件");
        return;
      }
      const restored = [];
      if (Array.isArray(data.saved)) {
        storageSet("promptStudio.saved.v1", data.saved);
        renderSaved();
        restored.push(`收藏 ${data.saved.length} 条`);
      }
      if (Array.isArray(data.history)) {
        storageSet("promptStudio.history.v1", data.history);
        renderHistory();
        restored.push(`历史 ${data.history.length} 条`);
      }
      if (Array.isArray(data.loras)) {
        storageSet("promptStudio.loras.v1", data.loras);
        renderLoras();
        restored.push(`LoRA ${data.loras.length} 条`);
      }
      if (data.stylePresets && typeof data.stylePresets === "object") {
        storageSet("promptStudio.stylePresets.v1", data.stylePresets);
        loadCustomStylePresets();
        restored.push(`人物风格 ${Object.keys(data.stylePresets).length} 条`);
      }
      if (data.state) {
        applyState(data.state);
        restored.push("当前选项");
      }
      updateOutput();
      saveAutosave();
      showToast(`已恢复：${restored.join("、")}`);
    } catch (error) {
      showToast("恢复失败：文件格式不对");
    }
  }

