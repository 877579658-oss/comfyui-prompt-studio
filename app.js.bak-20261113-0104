    const existing = getMyLoras();
    const names = new Set(existing.map((item) => String(item.name || "").toLowerCase()).filter(Boolean));
    const ids = new Set(existing.map((item) => String(item.catalogId || item.id || "")).filter(Boolean));
    const merged = [...existing];
    for (const item of LORA_CATALOG) {
      const nameKey = String(item.name || "").toLowerCase();
      if (ids.has(item.catalogId) || names.has(nameKey)) continue;
      merged.push({
        ...item,
        id: item.catalogId,
        enabled: false
      });
      ids.add(item.catalogId);
      names.add(nameKey);
    }
    storageSet("promptStudio.loras.v1", merged);
    localStorage.setItem(markerKey, LORA_CATALOG_VERSION);
    return merged;
  }

  function saveMyLoras(list) {
    storageSet("promptStudio.loras.v1", list);
    renderLoras();
    updateOutput();
    saveAutosave();
  }

  function enabledLoras() {
    const loraUi = document.querySelector(".lora-ui");
    if (loraUi?.hidden) return [];
    return getMyLoras().filter((item) => item.enabled && String(item.trigger || "").trim());
  }

  function activeLoraTokens(model = getModel()) {
    const tokens = [];
    const push = (value) => {
      const text = String(value || "").trim();
      if (text && !tokens.includes(text)) tokens.push(text);
    };
    push(inputValue("loraTrigger"));
    if (!tokens.length) push(model.trigger);
    for (const item of enabledLoras()) push(item.trigger);
    return tokens;
  }

  function renderLoras() {
    const root = $("loraList");
    if (!root) return;
    root.innerHTML = "";
    const list = getMyLoras();
    if (!list.length) {
      const empty = document.createElement("div");
      empty.className = "lora-empty";
      empty.textContent = "还没有条目。点右上「＋ 添加」写一条，或先导入清单。";
      root.append(empty);
      return;
    }
    for (const item of list) {
      const row = document.createElement("div");
      row.className = `lora-row${item.enabled ? " is-on" : ""}`;
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = Boolean(item.enabled);
      checkbox.title = "勾选后拼进提示词";
      checkbox.addEventListener("change", () => {
        const next = getMyLoras().map((entry) =>
          entry.id === item.id ? { ...entry, enabled: checkbox.checked } : entry
        );
        saveMyLoras(next);
      });
      const text = document.createElement("div");
      text.className = "lora-text";
      const title = document.createElement("strong");
      title.textContent = item.name || item.trigger;
      const sub = document.createElement("small");
      sub.textContent = `${item.trigger} · 权重 ${item.weight}`;
      text.append(title, sub);
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "text-button danger";
      remove.textContent = "删除";
      remove.addEventListener("click", () => {
        saveMyLoras(getMyLoras().filter((entry) => entry.id !== item.id));
      });
      row.append(checkbox, text, remove);
      root.append(row);
    }
  }

  // 批量粘贴：每行一条，支持「触发词」「触发词,0.8」「名称,触发词,0.8」
  function parseLoraLines(text) {
    const existing = getMyLoras();
    const seen = new Set(existing.map((item) => item.trigger));
    const added = [];
    for (const raw of String(text || "").split(/\r?\n/)) {
      const line = raw.trim();
      if (!line || line.startsWith("#")) continue;
      const parts = line.split(/\s*[,，\t|]\s*/).filter((part) => part !== "");
      if (!parts.length) continue;
      let name = "";
      let trigger = "";
      let weight = 0.8;
      if (parts.length === 1) {
        trigger = parts[0];
      } else if (parts.length === 2 && !Number.isNaN(Number(parts[1]))) {
        trigger = parts[0];
        weight = Number(parts[1]);
      } else {
        name = parts[0];
        trigger = parts[1];
        weight = Number(parts[2]);
      }
      trigger = String(trigger || "").trim();
      if (!trigger || seen.has(trigger)) continue;
      seen.add(trigger);
      added.push({
        id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
        name,
        trigger,
        weight: Number.isNaN(weight) ? 0.8 : Math.min(2, Math.max(0.1, weight)),
        enabled: true
      });
    }
    return added;
  }

  function addLora() {
    const trigger = inputValue("loraTriggerInput");
    if (!trigger) {
      showToast("先填触发词");
      return;
    }
    const weight = Number($("loraWeight").value) || 0.8;
    const list = getMyLoras();
    list.push({
      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
      name: inputValue("loraName"),
      trigger,
      weight: Math.min(2, Math.max(0.1, weight)),
      enabled: true
    });
    saveMyLoras(list);
    $("loraName").value = "";
    $("loraTriggerInput").value = "";
    $("loraForm").hidden = true;
    showToast("已加入清单，并勾选启用");
  }

  function exportLoras() {
    const payload = { version: 1, loras: getMyLoras() };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json;charset=utf-8" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `prompt-studio-loras-${new Date().toISOString().slice(0, 10)}.json`;
    link.click();
    URL.revokeObjectURL(link.href);
  }

  async function importLoras(file) {
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      const incoming = Array.isArray(data) ? data : data.loras;
      if (!Array.isArray(incoming)) throw new Error("格式不对");
      const existing = getMyLoras();
      const seen = new Set(existing.map((item) => item.trigger));
      let added = 0;
      for (const item of incoming) {
        const trigger = String(item?.trigger || "").trim();
        if (!trigger || seen.has(trigger)) continue;
        existing.push({
          id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
          name: String(item.name || ""),
          trigger,
          weight: Math.min(2, Math.max(0.1, Number(item.weight) || 0.8)),
          enabled: Boolean(item.enabled)
        });
        seen.add(trigger);
        added += 1;
      }
      saveMyLoras(existing);
      showToast(`已导入 ${added} 条`);
    } catch (error) {
      showToast("导入失败：文件格式不对");
    }
  }

  function buildOutput() {
    const model = getModel();
    let positive = capitalizeSentences(dedupePrompt(buildPromptFor("en", model), "en"));
    let positiveZh = dedupePrompt(buildPromptFor("zh", model), "zh");
    const negative = buildNegative(model);
    const state = collectState();
    // 触发词顺序：手填 > 模型自带 > 清单里勾选的
    const tokens = activeLoraTokens(model);
    if (tokens.length) {
      positive = `${tokens.join(", ")}, ${positive}`;
      positiveZh = `${tokens.join(", ")}，${positiveZh}`;
    }
    const json = {
      version: 2,
      generatedAt: new Date().toISOString(),
      model: {
        id: model.key,
        name: model.label,
        type: model.type,
        format: model.format
      },
      settings: state,
      size: getSize(),
      trigger: tokens.join(", "),
      loras: enabledLoras().map((item) => ({ name: item.name, trigger: item.trigger, weight: item.weight })),
      prompt: positive,
      promptZh: positiveZh,
      negativePrompt: negative
    };
    return { positive, positiveZh, negative, json, model };
  }

  // 输出框可以直接改，复制/收藏/检查都以框里的文本为准
  function currentPositive() {
    const el = $("promptOutput");
    if (el) return el.value;
    return latestOutput ? latestOutput.positive : "";
  }

  function currentPositiveZh() {
    const el = $("promptZhOutput");
    if (el) return el.value;
    return latestOutput ? latestOutput.positiveZh : "";
  }

  function currentEnglish() {
    return primaryLanguage === "zh" ? currentPositiveZh() : currentPositive();
  }

  function currentChinese() {
    return primaryLanguage === "zh" ? currentPositive() : currentPositiveZh();
  }

  function currentJson() {
    if (!latestOutput) return "";
    const json = {
      ...latestOutput.json,
      primaryLanguage,
      prompt: currentPositive(),
      promptZh: currentPositiveZh()
    };
    return JSON.stringify(json, null, 2);
  }

  function updatePromptStats() {
    const text = currentPositive();
    const textZh = currentPositiveZh();
    const characters = text.length;
    const hanCount = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
    const wordCount = text.trim().split(/\s+/).filter(Boolean).length;
    const zhCharacters = textZh.length;
    const zhHanCount = (textZh.match(/[\u4e00-\u9fa5]/g) || []).length;
    const size = getSize();
    const sizeLabel = size.width && size.height ? ` · ${size.width}×${size.height}` : "";
    $("promptStats").textContent = (hanCount > wordCount * 2
      ? `${characters} 字符 · ${hanCount} 汉字`
      : `${characters} 字符 · ${wordCount} 词`) + sizeLabel;
    $("promptZhStats").textContent = `${zhCharacters} 字符 · ${zhHanCount} 汉字`;
    const status = $("bilingualStatus");
    if (status) {
      status.textContent = freeEditMode
        ? (manualOutput.en || manualOutput.zh
          ? "自由编辑中，中英文可能已不同步"
          : "自由编辑中，尚未手动修改")
        : `与${primaryLanguage === "zh" ? "中文" : "英文"}由同一组选项生成`;
    }
    if (!freeEditMode && missingCustomTranslations().length) {
      if (status) status.textContent = "自定义内容缺少另一语言；未自动翻译，请分别核对";
      $("outputModeHint").textContent = "只读 · 双语未配齐";
    } else if (!freeEditMode) $("outputModeHint").textContent = "同组选项生成，只读";
    $("jsonOutput").value = currentJson();
  }

  function updateOutput({ force = false } = {}) {
    primaryLanguage = "en";
    $("language").value = "en";
    latestOutput = buildOutput();
    const primary = primaryLanguage === "zh" ? latestOutput.positiveZh : latestOutput.positive;
    const secondary = primaryLanguage === "zh" ? latestOutput.positive : latestOutput.positiveZh;
    if (!freeEditMode || force) {
      $("promptOutput").value = primary;
      $("promptZhOutput").value = secondary;
      manualOutput.en = false;
      manualOutput.zh = false;
    } else {
      if (!manualOutput.en) $("promptOutput").value = primary;
      if (!manualOutput.zh) $("promptZhOutput").value = secondary;
    }
    $("negativeOutput").value = latestOutput.negative;
    $("outputModel").textContent = latestOutput.model.label;
    const outputSize = $("outputSize");
    if (outputSize) {
      const size = getSize();
      outputSize.textContent = size.width && size.height ? `${size.width} × ${size.height}` : "";
    }
    updatePromptStats();
    refreshFieldMarks();
    refreshUsability();
    const primaryLabel = $("primaryPromptLabel");
    const secondaryLabel = $("secondaryPromptLabel");
    if (primaryLabel) primaryLabel.textContent = primaryLanguage === "zh" ? "中文主提示词" : "English 主提示词";
    if (secondaryLabel) secondaryLabel.textContent = primaryLanguage === "zh" ? "English 参考" : "中文参考";
    if ($("copyPromptLarge")) {
      $("copyPromptLarge").textContent = primaryLanguage === "zh" ? "复制中文提示词" : "复制英文提示词";
    }
    if ($("copyPromptZh")) {
      $("copyPromptZh").textContent = primaryLanguage === "zh" ? "复制英文" : "复制中文";
    }
    flashOutput();
  }

  // 结果刷新淡入：给当前活跃的输出框重放一次短暂的淡入动画，强化「已刷新」感知
  function flashOutput() {
    const el = document.querySelector(".tab-panel.active .output-text");
    if (!el) return;
    el.classList.remove("is-flashing");
    // 强制回流后再加回，确保动画能重放
    void el.offsetWidth;
    el.classList.add("is-flashing");
  }

  function setFreeEditMode(enabled) {
    freeEditMode = enabled;
    $("promptOutput").readOnly = !enabled;
    $("promptZhOutput").readOnly = !enabled;
    $("outputModeHint").textContent = enabled
      ? "自由编辑，不再保证中英文同步"
      : "严格同步，只读";
    $("editOutputButton").textContent = enabled ? "恢复同步模式" : "自由编辑";
    if (!enabled) updateOutput({ force: true });
    else updatePromptStats();
  }

  function showToast(message) {
    const toast = $("toast");
    toast.textContent = message;
    toast.classList.add("show");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("show"), 1900);
  }

  async function copyText(text, successMessage = "已复制") {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const temp = document.createElement("textarea");
        temp.value = text;
        temp.setAttribute("readonly", "");
        temp.style.position = "fixed";
        temp.style.opacity = "0";
        document.body.append(temp);
        temp.select();
        const copied = document.execCommand("copy");
        temp.remove();
        if (!copied) throw new Error("copy failed");
      }
      addHistory();
      showToast(successMessage);
    } catch (error) {
      showToast("自动复制失败，请手动选中右侧文本复制");
    }
  }

  function storageGet(key, fallback) {
    try {
      const value = localStorage.getItem(key);
      return value ? JSON.parse(value) : fallback;
    } catch {
      return fallback;
    }
  }

  function storageSet(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
      if (key === "promptStudio.autosave.v1" && $("saveStatus")) {
        $("saveStatus").textContent = `已保存 ${new Date().toLocaleTimeString("zh-CN", {hour12:false})}`;
        $("saveStatus").dataset.state = "saved";
      }
      return true;
    } catch {
      if ($("saveStatus")) { $("saveStatus").textContent = "保存失败，请导出备份"; $("saveStatus").dataset.state = "error"; }
      showToast("浏览器存储不可用，当前修改不会持久保存");
      return false;
    }
  }

  function getSavedPresets() {
    return storageGet("promptStudio.saved.v1", []);
  }

  function getHistory() {
    return storageGet("promptStudio.history.v1", []);
  }

  function addHistory() {
    if (!latestOutput) return;
    const history = getHistory();
    const item = {
      id: crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`,
      createdAt: Date.now(),
      title: `${latestOutput.model.label} · ${currentPositive().slice(0, 42)}`,
      prompt: currentPositive(),
      promptZh: currentPositiveZh(),
      freeEdited: freeEditMode && (manualOutput.en || manualOutput.zh),
      state: collectState()
    };
    const next = [item, ...history.filter((entry) => entry.prompt !== item.prompt)].slice(0, 20);
    storageSet("promptStudio.history.v1", next);
    renderHistory();
  }

  function savePreset() {
    const suggested = new Date().toLocaleString("zh-CN", { hour12: false });
    const name = window.prompt("给这个方案起个名字：", `方案 ${suggested}`);
    if (!name?.trim()) return;
    const saved = getSavedPresets();
    saved.unshift({
      id: crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`,
      name: name.trim(),
      createdAt: Date.now(),
      state: collectState(),
      prompt: currentPositive(),
      promptZh: currentPositiveZh(),
      freeEdited: freeEditMode && (manualOutput.en || manualOutput.zh)
    });
    storageSet("promptStudio.saved.v1", saved.slice(0, 100));
    renderSaved();
    showToast("方案已收藏");
  }

  function createSavedItem(item, { history = false } = {}) {
    const row = document.createElement("div");
    row.className = "saved-item";
    const text = document.createElement("div");
    const title = document.createElement("strong");
    const summary = document.createElement("small");
    title.textContent = history ? item.title : item.name;
    title.dataset.originalTitle = title.textContent;
    title.dataset.privateTitle = history ? "历史方案（内容已隐藏）" : "收藏方案（名称已隐藏）";
    summary.textContent = new Date(item.createdAt).toLocaleString("zh-CN", { hour12: false });
    text.append(title, summary);

    const actions = document.createElement("div");
    actions.className = "saved-item-actions";
    const load = document.createElement("button");
    load.className = "tiny-button";
    load.type = "button";
    load.title = "载入";
    load.textContent = "↺";
    load.addEventListener("click", () => {
      applyState(item.state);
      if (item.promptZh) {
        if (item.freeEdited) setFreeEditMode(true);
        $("promptOutput").value = item.prompt || "";
        $("promptZhOutput").value = item.promptZh;
        manualOutput.en = Boolean(item.freeEdited);
        manualOutput.zh = Boolean(item.freeEdited);
        updatePromptStats();
      }
      showToast(history ? "已恢复历史方案" : `已载入「${item.name}」`);
    });
    actions.append(load);

    if (!history) {
      const remove = document.createElement("button");
      remove.className = "tiny-button";
      remove.type = "button";
      remove.title = "删除";
      remove.textContent = "×";
      remove.addEventListener("click", () => {
        if (!window.confirm(`删除收藏「${item.name}」？`)) return;
        storageSet("promptStudio.saved.v1", getSavedPresets().filter((entry) => entry.id !== item.id));
        renderSaved();
        showToast("收藏已删除");
      });
      actions.append(remove);
    }
    row.append(text, actions);
    return row;
  }

  function renderSaved() {
    const root = $("savedList");
    root.innerHTML = "";
    const saved = getSavedPresets();
    if (!saved.length) {
      const empty = document.createElement("div");
      empty.className = "saved-empty";
      empty.textContent = "还没有收藏。生成后点击“收藏”即可保存整套参数。";
      root.append(empty);
      return;
    }
    saved.forEach((item) => root.append(createSavedItem(item)));
    applySavedPrivacy();
  }

  function renderHistory() {
    const root = $("historyList");
    root.innerHTML = "";
    const history = getHistory();
    if (!history.length) {
      const empty = document.createElement("div");
      empty.className = "saved-empty";
      empty.textContent = "复制提示词后，这里会自动保留最近 20 条记录。";
      root.append(empty);
      return;
    }
    history.forEach((item) => root.append(createSavedItem(item, { history: true })));
    applySavedPrivacy();
  }

