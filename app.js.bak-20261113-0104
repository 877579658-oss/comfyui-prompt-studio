  function toggleScaleLock() {
    storageSet("promptStudio.scaleLock.v1", !scaleLocked());
    applyScaleLock();
    showToast(scaleLocked() ? "尺度已锁定" : "尺度已解锁");
  }

  // 顶层已选项覆盖的字段：这些保持不动，其余字段在「套用 + 其余随机」时重抽
  const QUICK_FIXED_FIELDS = [
    "model",
    "language",
    "detailLevel",
    "contentScale",
    "subjectType",
    "relationshipType",
    "audienceOrientation",
    "relationshipDynamic",
    "gender",
    "firstGender",
    "secondGender",
    "thirdGender",
    "firstPosition",
    "secondPosition",
    "thirdPosition",
    "customFormat",
    "rolePreset",
    "appearance",
    "age",
    "visualStyle",
    "stylePreset",
    "styleLook",
    "outfitMode",
    "outfitState",
    "aspectRatio"
  ];

  function quickProtectedFields() {
    return new Set([
      ...QUICK_FIXED_FIELDS,
      ...STYLE_CORE_FIELDS,
      ...STYLE_LOOK_COMPONENT_FIELDS,
      ...HOSIERY_DETAIL_FIELDS,
      ...CAMERA_PLAN_COMPONENT_FIELDS
    ]);
  }

  function captureModifiedDetailFields() {
    const fields = new Map();
    for (const field of Object.keys(FIELD_TO_OPTIONS)) {
      if (!$(field)) continue;
      if (randomGeneratedFields.has(field) && !userTouchedFields.has(field)) continue;
      if (!fieldModified(field) && !userTouchedFields.has(field)) continue;
      fields.set(field, $(field).value);
    }
    return fields;
  }

  function randomizeRemainingFields(extraProtected = new Set()) {
    const protectedFields = new Set([...quickProtectedFields(), ...extraProtected]);
    const rate = ADULT_RANDOM_RATE[contentScale()] ?? 0;
    const presentation = randomPresentation();
    let changed = 0;
    for (const [field] of Object.entries(FIELD_TO_OPTIONS)) {
      if (protectedFields.has(field)) continue;
      if (!fieldAppliesTo(field)) continue;
      if (field === "aspectRatio" && lockedAspectRatio()) continue;
      const pick = pickRandomFieldValue(field, rate, presentation);
      if (pick && $(field)?.value !== pick) {
        setSelectValue(field, pick);
        randomGeneratedFields.add(field);
        userTouchedFields.delete(field);
        changed += 1;
      }
    }
    return changed;
  }

  function applyQuickSelection(modeOverride = null) {
    if (!$("stylePreset")?.value) {
      showToast("先选择人物风格");
      return;
    }
    const applyMode = modeOverride || styleCurrentMode();
    const revealScenario = applyMode === "makeup" ? null : selectedRevealScenario();
    const revealPose = applyMode === "makeup" ? null : selectedRevealPose();
    const quickAdultProp = applyMode === "makeup" ? "" : $("adultPropQuick")?.value || "";
    const detailLocks = captureModifiedDetailFields();
    const scenarioCameraItem = revealScenario?.cameraPlan
      ? getOptionPairs("cameraPlan").find((item) => item.en === revealScenario.cameraPlan)
      : null;
    const quickCamera = scenarioCameraItem ||
      getOptionPairs("cameraPlan").find((item) => item.en === $("cameraPlanQuick")?.value);
    const needsRevealing = Boolean(revealScenario) || (
      (
        styleCurrentMode() !== "makeup" &&
        ["half-nude", "nude"].includes($("topOutfitState")?.value || "")
      ) ||
      Boolean(quickCamera?.plan?.requiresReveal)
    );
    if (needsRevealing && contentScale() !== "revealing") {
      applyScaleLock();
      showToast("此预设与当前尺度不兼容。未修改任何设置，请手动选择合适尺度。");
      return;
    }
    lastRandomState = collectState();
    const randomBefore = applyMode === "random-rest" ? captureFieldValues() : null;
    const pendingStylePreset = $("stylePreset")?.value || "";
    const pendingStyleLook = $("styleLook")?.value || "";
    if (needsRevealing && contentScale() !== "revealing") {
      setContentScale("revealing");
      setSelectValue("stylePreset", pendingStylePreset);
      rebuildStyleLookOptions();
      setSelectValue("styleLook", pendingStyleLook);
    }
    setSelectValue("appearance", $("topPerson")?.value || "");
    setSelectValue("age", $("topAge")?.value || "in their thirties");
    setSelectValue("visualStyle", $("topVisualStyle")?.value || "");
    if (quickCamera?.en) setSelectValue("cameraPlan", quickCamera.en);
    rebuildStyleLookOptions();
    let fixes = applyStylePreset();
    if (!$("styleLook")?.value && styleCurrentMode() !== "makeup") {
      const state = $("topOutfitState")?.value || "dressed";
      if (state === "nude") {
        applyOutfitState("nude");
      } else {
        applyOutfitState("dressed");
        setSelectValue("outfitMode", state === "half-nude" ? "half-nude styling" : "normal outfit");
      }
    }
    if (quickCamera?.en) fixes += applyCameraPlan(quickCamera);
    if (revealScenario) fixes += applyRevealScenario(revealScenario);
    if (revealPose) fixes += applyRevealPose(revealPose);
    if (contentScale() === "revealing") fixes += applyAdultProp(quickAdultProp);

    const topControlled = new Set([
      ...QUICK_FIXED_FIELDS,
      ...STYLE_CORE_FIELDS,
      ...STYLE_OUTFIT_FIELDS,
      ...STYLE_LOOK_COMPONENT_FIELDS,
      ...HOSIERY_DETAIL_FIELDS,
      ...(quickCamera ? CAMERA_PLAN_COMPONENT_FIELDS : []),
      ...(quickCamera ? CAMERA_PLAN_BEHAVIOR_FIELDS : []),
      ...(revealScenario ? Object.keys(revealScenario.fields || {}) : []),
      ...(revealPose ? Object.keys(revealPose.fields || {}) : []),
      ...(contentScale() === "revealing" ? ["adultProp"] : [])
    ]);
    const fixedCount = new Set([...topControlled, ...detailLocks.keys()]).size;
    for (const [field, value] of detailLocks) {
      if (topControlled.has(field) || !optionExists(field, value)) continue;
      if ($(field)?.value !== value) {
        setSelectValue(field, value);
        fixes += 1;
      }
    }
    setSelectValue("appearance", $("topPerson")?.value || "");
    setSelectValue("age", $("topAge")?.value || "in their thirties");
    setSelectValue("visualStyle", $("topVisualStyle")?.value || "");
    quickPresetDirty = false;
    quickPresetApplied = true;
    appliedStylePreset = $("stylePreset").value;
    let randomizedCount = 0;
    if (applyMode === "random-rest") {
      const extraProtected = new Set([
        ...detailLocks.keys(),
        ...(quickCamera ? CAMERA_PLAN_COMPONENT_FIELDS : []),
        ...(quickCamera ? CAMERA_PLAN_BEHAVIOR_FIELDS : []),
        ...(revealScenario ? Object.keys(revealScenario.fields || {}) : []),
        ...(revealPose ? Object.keys(revealPose.fields || {}) : []),
        ...(contentScale() === "revealing" ? ["adultProp"] : [])
      ]);
      randomizedCount = randomizeRemainingFields(extraProtected);
      sanitizeRandomSelection();
      resolveConflicts(null);
      if (quickCamera?.en) {
        setSelectValue("cameraPlan", quickCamera.en);
        applyCameraPlan(quickCamera);
      }
      if (revealScenario) applyRevealScenario(revealScenario);
      if (revealPose) applyRevealPose(revealPose);
      if (contentScale() === "revealing") applyAdultProp(quickAdultProp);
      setSelectValue("appearance", $("topPerson")?.value || "");
      setSelectValue("age", $("topAge")?.value || "in their thirties");
      setSelectValue("visualStyle", $("topVisualStyle")?.value || "");
      markRandomizedChanges(randomBefore, topControlled);
      updateUndoButton();
    }
    lastApplyMeta = applyMode === "random-rest"
      ? `固定 ${fixedCount} 项 / 随机 ${randomizedCount} 项`
      : "整套套用";
    lastUndoLabel = applyMode === "random-rest" ? "撤销刚才的套用与随机" : "撤销刚才的套用";
    updateVisibility();
    updateOutput();
    saveAutosave();
    renderWizardChecks();
    const appliedMsg = applyMode === "random-rest"
      ? `已固定 ${fixedCount} 项，随机补全 ${randomizedCount} 项`
      : "已套用当前预设";
    showToast(appliedMsg);
    return fixes;
  }

  function randomizeTopPresets() {
    const availableStyleKeys = new Set(
      (O.styleLook || [])
        .filter((item) => item.en && item.styleKey && optionAllowedAtCurrentScale(item, "styleLook"))
        .map((item) => item.styleKey)
    );
    const styleKeys = Object.keys(STYLE_PRESETS).filter((key) =>
      STYLE_PRESETS[key]?.fields && availableStyleKeys.has(key)
    );
    if (!styleKeys.length) {
      showToast("当前没有可用人物风格");
      return 0;
    }
    lastRandomState = collectState();
    const personOptions = [...$("topPerson").options].filter((option) => option.value);
    const person = personOptions[Math.floor(Math.random() * personOptions.length)];
    setSelectValue("topPerson", person.value);
    const ageOptions = [...$("topAge").options].filter((option) => option.value);
    const age = ageOptions[Math.floor(Math.random() * ageOptions.length)];
    setSelectValue("topAge", age.value);
    const styleKey = styleKeys[Math.floor(Math.random() * styleKeys.length)];
    setSelectValue("stylePreset", styleKey);
    rebuildStyleLookOptions();
    const allowedStates = contentScale() === "revealing"
      ? ["half-nude", "nude"]
      : ["dressed"];
    const outfitState = allowedStates[Math.floor(Math.random() * allowedStates.length)];
    setSelectValue("topOutfitState", outfitState);
    const looks = quickStyleLookOptions().filter((item) =>
      item.en &&
      item.en !== "custom style look" &&
      item.styleKey === styleKey &&
      (
        outfitState === "nude"
          ? STYLE_LOOKS[item.en]?.outfitMode === "fully nude"
          : outfitState === "half-nude"
            ? STYLE_LOOKS[item.en]?.outfitMode === "half-nude styling"
            : STYLE_LOOKS[item.en]?.outfitMode !== "fully nude"
      )
    );
    const look = looks[Math.floor(Math.random() * looks.length)];
    if (look?.en) setSelectValue("styleLook", look.en);
    const visualOptions = getOptionPairs("visualStyle").filter((item) => item.en);
    const visual = visualOptions[Math.floor(Math.random() * visualOptions.length)];
    setSelectValue("topVisualStyle", visual?.en || "");
    let revealScenario = null;
    if (contentScale() === "revealing") {
      const targetKey = $("revealTargetQuick")?.value || "all";
      const intensityKey = $("revealIntensityQuick")?.value || "all";
      const scenarios = (REVEAL_SCENARIOS || [])
        .filter(revealScenarioCompatible)
        .filter((item) => targetKey === "all" || item.target === targetKey)
        .filter((item) => intensityKey === "all" || revealScenarioIntensity(item) === intensityKey);
      revealScenario = pickFreshRandom(scenarios, "scenario", (item) => item.key, 4);
      if (revealScenario) {
        setSelectValue("revealScenarioQuick", revealScenario.key);
        setSelectValue("cameraPlanQuick", revealScenario.cameraPlan || "");
        if (revealScenario.fields?.visualStyle && optionExists("topVisualStyle", revealScenario.fields.visualStyle)) {
          setSelectValue("topVisualStyle", revealScenario.fields.visualStyle);
        }
      }
      const poses = (REVEAL_POSES || []).filter(revealPoseCompatible);
      if (poses.length) {
        const pose = pickFreshRandom(poses, "pose", (item) => item.key, 3);
        setSelectValue("revealPoseQuick", pose.key);
      }
      const props = (O.adultProp || []).filter((item) => item.en && revealPropCompatible(item));
      setSelectValue("adultPropQuick", props.length && Math.random() < 0.4
        ? pickFreshRandom(props, "prop", (item) => item.en, 5).en
        : "");
    } else {
      setSelectValue("revealScenarioQuick", "");
      setSelectValue("revealTargetQuick", "all");
      setSelectValue("revealIntensityQuick", "all");
      setSelectValue("revealPoseQuick", "");
      setSelectValue("adultPropQuick", "");
    }
    if (!revealScenario) {
      const camera = chooseCameraPlan({ apply: false });
      if (camera?.picked?.en) setSelectValue("cameraPlanQuick", camera.picked.en);
    }
    quickPresetDirty = true;
    const fixes = applyQuickSelection("full");
    quickPresetDirty = false;
    updateVisibility();
    updateOutput();
    saveAutosave();
    renderWizardChecks();
    updateUndoButton();
    updateQuickLookSummary();
    showToast(`已随机：${$("quickLookSummary")?.textContent || "顶层预设"}`);
    return fixes;
  }

  function copyOutfitToOtherRoles() {
    const targetRoles = OUTFIT_ROLES.filter((role) => role !== outfitRole && roleExists(role));
    if (!targetRoles.length) {
      showToast("当前没有其他角色可应用");
      return;
    }
    const names = [
      "outfitMode", "sheerMaterial", "sheerLevel", "halfNudeStyle", "coveredOpacity",
      "coveredGarment", "coveredMaterial", "coveredInner", "coveredColor", "coveredFit",
      "outfit", "fabric", "outfitColor", "fit", "accessories", "footwear", "hosiery"
    ];
    for (const targetRole of targetRoles) {
      for (const name of names) {
        const from = roleFieldId(name, outfitRole);
        const to = roleFieldId(name, targetRole);
        if (!$(from) || !$(to)) continue;
        if (optionExists(to, $(from).value)) setSelectValue(to, $(from).value);
      }
    }
    refreshHalfNudeDependents();
    updateVisibility();
    updateOutput();
    saveAutosave();
    renderWizardChecks();
    showToast(`已将角色 ${outfitRole === "first" ? "A" : outfitRole === "second" ? "B" : "C"} 的服装应用到其他角色`);
  }

  function renderWizardCategories() {
    const root = $("wizardCategories");
    if (!root) return;
    const sectionKey = WIZARD_STEPS[wizardIndex][0];
    const categories = currentWizardCategories();
    let activeIndex = Number(wizardCategoryState[sectionKey]) || 0;
    if (activeIndex < 0 || activeIndex >= categories.length) activeIndex = 0;
    wizardCategoryState[sectionKey] = activeIndex;
    root.innerHTML = "";
    categories.forEach((category, index) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = `wizard-category${index === activeIndex ? " is-active" : ""}`;
      button.setAttribute("role", "tab");
      button.setAttribute("aria-selected", String(index === activeIndex));
      button.textContent = category.label;
      button.addEventListener("click", () => {
        wizardCategoryState[sectionKey] = index;
        renderWizardCategories();
      });
      root.append(button);
    });
    applyWizardCategoryVisibility();
  }

  function analyzeWizardStep(index) {
    const [id, , label] = WIZARD_STEPS[index];
    const model = getModel();
    const issues = [];
    const add = (status, message) => issues.push({ status, message });

    if (id === "section-model") {
      const size = getSize();
      const sizeValid =
        size.width >= 256 && size.width <= 4096 &&
        size.height >= 256 && size.height <= 4096;
      if (!sizeValid) add("fail", "画面宽高需要在 256 到 4096 之间。");
      else if (size.width % 8 || size.height % 8) add("warn", "尺寸未对齐 8 像素，请核对具体工作流要求。");
      if (loraDirectEnabled() && model.type !== "image") {
        add("warn", "LoRA 直出只作用于图像模型，视频仍使用完整结构。");
      }
      if (loraDirectEnabled() && !inputValue("loraTrigger") && !model.trigger) {
        add("warn", "LoRA 直出建议填写触发词，否则页面不知道该附加什么。");
      }
    }

    if (id === "section-character") {
      const type = $("subjectType").value;
      if (type === "object") {
        if (!customText("objectDescription", "en") && !customText("objectDescription", "zh")) {
          add("warn", "补充物体描述后画面会更稳定。");
        }
      } else if (type !== "creature") {
        if (!$("gender").value || !$("age").value) add("fail", "请选择成年角色和年龄感。");
        const genderOption = (O.gender || []).find((item) => item.en === $("gender").value);
        const people = genderOption?.people || 1;
        const expected = type === "couple" ? 2 : type === "group" ? 3 : 1;
        if (people !== expected) add("warn", `当前主体需要 ${expected} 人，性别描述却是 ${people} 人。`);
      }
    }

    if (id === "section-outfit") {
      if ($("subjectType").value !== "object" && !$("outfitMode").value) {
        add("fail", "请选择着装方式。");
      }
      if ($("outfitMode").value === "fully nude" && $("garmentGraphicZone").value) {
        add("warn", "裸体模式不会使用服装图案，当前图案位置会被忽略。");
      }
    }

    if (id === "section-action") {
      if (!$("pose").value && !$("action").value) add("warn", "至少选择一个姿势或主要动作。");
      if (contentScale() === "revealing" && $("revealMode").value && !$("revealAction").value) {
        add("warn", "已选择露点表现，但还没有对应动作。");
      }
      const positions = ["firstPosition", "secondPosition", "thirdPosition"]
        .map((field) => $(field)?.value)
        .filter(Boolean);
      if (new Set(positions).size < positions.length) {
        add("warn", "多个角色使用了相同的画面位置。");
      }
      if (BACK_ONLY_ORIENTATION.test($("bodyOrientation").value) && FRONT_FACING_BODY_FOCUS.test($("bodyFocus").value)) {
        add("warn", "背面朝向与当前正面焦点可能冲突。");
      }
      if ($("subjectType").value === "group" && !$("bodyFocusTertiary").value) {
        add("warn", "三人画面还没有第三人物焦点。");
      }
    }

    if (id === "section-scene") {
      if (!$("scene").value) add("warn", "选择场景后画面完成度会更高。");
      if (model.type === "video" && !$("sound").value) add("warn", "视频模型建议填写音频线索。");
    }

    if (id === "section-camera") {
      if (!$("shotSize").value && !$("angle").value && !$("lens").value) {
        add("warn", "至少选择一个景别、机位或焦段。");
      }
      if (model.cameraLocked && $("cameraMove").value && $("cameraMove").value !== "static camera") {
        add("warn", "该模型建议固定机位，当前运镜可能降低稳定性。");
      }
    }

    if (id === "section-style") {
      const prompt = currentPositive().trim();
      const clauses = prompt.split(/[,，\n]/).map((part) => part.trim()).filter(Boolean);
      const duplicates = new Set();
      const seen = new Set();
      for (const clause of clauses) {
        const key = clause.toLowerCase();
        if (seen.has(key)) duplicates.add(clause);
        seen.add(key);
      }
      if (duplicates.size) add("warn", `检测到 ${duplicates.size} 个重复片段，建议精简。`);
      if (!prompt) add("warn", "当前还没有生成提示词。");
    }

    for (const issue of detectSemanticIssues()) {
      if (issue.step === id) add("warn", issue.detail);
    }

    const status = issues.some((item) => item.status === "fail")
      ? "fail"
      : issues.some((item) => item.status === "warn")
        ? "warn"
        : "pass";
    return {
      status,
      label,
      message: issues[0]?.message || "本步信息已就绪。"
    };
  }

  function renderWizardChecks() {
    const root = $("wizardCheck");
    if (!root) return;
    const checks = WIZARD_STEPS.map((_, index) => analyzeWizardStep(index));
    const buttons = $$("#wizardSteps .wizard-step");
    buttons.forEach((button, index) => {
      const check = checks[index];
      button.classList.toggle("has-fail", check.status === "fail");
      button.classList.toggle("has-warn", check.status === "warn");
      button.title = `${check.label}：${check.message}`;
    });
    const current = checks[wizardIndex] || checks[0];
    root.dataset.status = current.status;
    root.textContent = `${current.label}：${current.message}`;
  }

  function goToWizardStep(index) {
    wizardIndex = Math.max(0, Math.min(WIZARD_STEPS.length - 1, index));
    storageSet("promptStudio.wizardStep.v1", wizardIndex);
    applyWizardStep();
    renderWizardChecks();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function detectSemanticIssues() {
    const issues = [];
    const add = (step, title, detail) => issues.push({ step, title, detail });
    const pose = `${pairText("pose", "zh")} ${pairText("pose", "en")}`.toLowerCase();
    const legPose = `${pairText("legPose", "zh")} ${pairText("legPose", "en")}`.toLowerCase();
    const primaryFocus = pairText("bodyFocus", "zh");
    const secondaryFocus = pairText("bodyFocusSecondary", "zh");
    const tertiaryFocus = pairText("bodyFocusTertiary", "zh");
    const legPattern = /leg|knee|thigh|calf|ankle|腿|膝|脚踝/;

    if (pose && legPose && legPattern.test(pose) && legPattern.test(legPose)) {
      add("section-action", "腿部描述重复", "姿势和腿部姿势都在描述腿部，建议删除其中一个，避免动作冲突。");
    }
    if (BACK_ONLY_ORIENTATION.test($("bodyOrientation").value) && FRONT_FACING_BODY_FOCUS.test($("bodyFocus").value)) {
      add("section-action", "朝向与焦点冲突", "身体背对镜头时，正面胸廓、前裆或面部不应作为主焦点。");
    }
    const focusValues = [primaryFocus, secondaryFocus, tertiaryFocus].filter(Boolean);
    if (new Set(focusValues).size < focusValues.length) {
      add("section-action", "人物焦点重复", "两个人物的镜头焦点相同，多人画面会失去层次。");
    }
    const positionValues = ["firstPosition", "secondPosition", "thirdPosition"]
      .map((field) => $(field)?.value)
      .filter(Boolean);
    if (new Set(positionValues).size < positionValues.length) {
      add("section-action", "人物位置重复", "多个角色选择了相同的画面位置，容易导致人物重叠或被模型合并。");
    }
    const secondHair = $("secondHairStyle")?.value;
    const secondOutfit = $("secondOutfit")?.value;
    if (
      secondHair && secondHair === $("hairStyle").value &&
      secondOutfit && secondOutfit === $("outfit").value
    ) {
      add("section-character", "角色识别点不足", "角色 A 与 B 的发型和服装完全相同，建议至少改变发色、服装颜色或配饰中的一个。");
    }
    if ($("subjectType").value === "group") {
      const thirdHair = $("thirdHairStyle")?.value;
      const thirdOutfit = $("thirdOutfit")?.value;
      if (
        (thirdHair && thirdHair === $("hairStyle").value && thirdOutfit && thirdOutfit === $("outfit").value) ||
        (thirdHair && thirdHair === secondHair && thirdOutfit && thirdOutfit === secondOutfit)
      ) {
        add("section-character", "角色 C 识别点不足", "角色 C 与其他角色的发型和服装完全相同，建议增加独立的颜色、发型或配饰差异。");
      }
    }
    if ($("subjectType").value === "person" && $("interaction").value) {
      add("section-action", "互动与人数冲突", "当前是单人主体，互动字段不会生效或可能强行生成第二个人。");
    }
    if ($("outfitMode").value === "fully nude" && $("garmentGraphicZone").value) {
      add("section-outfit", "裸体与图案冲突", "裸体模式不使用服装图案，请清空图案位置或切换着装方式。");
    }
    const lingerie = selectedRawItem("coveredGarment");
    const hosieryItem = selectedRawItem("hosiery");
    const hosieryTop = selectedRawItem("hosieryTop");
    const hosieryToe = selectedRawItem("hosieryToe");
    const footwear = selectedRawItem("footwear");
    if (isLingerieItem(lingerie) && hosieryItem && !lingerieHosieryCompatible(lingerie, hosieryItem)) {
      add("section-outfit", "内衣与丝袜结构冲突", "当前情趣内衣与丝袜的吊带或裆部结构不兼容，请改选另一种丝袜。");
