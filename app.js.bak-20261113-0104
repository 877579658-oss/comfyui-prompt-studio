  function chooseRevealScenario(key, { silent = false } = {}) {
    const scenario = (REVEAL_SCENARIOS || []).find((item) => item.key === key);
    if (!scenario || !revealScenarioCompatible(scenario)) return false;
    setSelectValue("revealScenarioQuick", scenario.key);
    setSelectValue("cameraPlanQuick", scenario.cameraPlan || "");
    if (scenario.fields?.visualStyle && optionExists("topVisualStyle", scenario.fields.visualStyle)) {
      setSelectValue("topVisualStyle", scenario.fields.visualStyle);
    }
    quickPresetDirty = true;
    fillRevealQuickOptions();
    updateVisibility();
    updateQuickLookSummary();
    saveAutosave();
    if (!silent) showToast(`已选露点方案「${scenario.zh}」，点「套用当前」生效`);
    return true;
  }

  function applyRevealScenario(scenario = selectedRevealScenario()) {
    if (!scenario) return 0;
    let changed = 0;
    const revealModeValue = scenario.fields?.revealMode;
    if (revealModeValue && $("revealMode") && optionExists("revealMode", revealModeValue)) {
      if ($("revealMode").value !== revealModeValue) {
        setSelectValue("revealMode", revealModeValue);
        changed += 1;
      }
      refreshRevealDependents();
    }
    for (const [field, value] of Object.entries(scenario.fields || {})) {
      if (field === "revealMode") continue;
      if (!value || !$(field) || !optionExists(field, value)) continue;
      if ($(field).value !== value) {
        setSelectValue(field, value);
        changed += 1;
      }
    }
    refreshRevealDependents();
    refreshAnatomyDependents();
    return changed;
  }

  function applyRevealPose(pose = selectedRevealPose()) {
    if (!pose || !revealPoseCompatible(pose)) return 0;
    let changed = 0;
    for (const [field, value] of Object.entries(pose.fields || {})) {
      if (!$(field)) continue;
      if (!value) {
        if ($(field).value) {
          clearSelectValue(field);
          changed += 1;
        }
        continue;
      }
      if (!optionExists(field, value)) continue;
      if ($(field).value !== value) {
        setSelectValue(field, value);
        changed += 1;
      }
    }
    return changed;
  }

  function applyAdultProp(value = $("adultPropQuick")?.value || "") {
    if (!value) {
      if ($("adultProp")?.value) {
        clearSelectValue("adultProp");
        return 1;
      }
      return 0;
    }
    if (!optionExists("adultProp", value) || $("adultProp")?.value === value) return 0;
    setSelectValue("adultProp", value);
    return 1;
  }

