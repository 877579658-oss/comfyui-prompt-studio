      sitting: 4,
      kneeling: 3,
      leaning: 3,
      dynamic: 3,
      back: 2,
      lying: 1,
      other: 1
    };
    const families = new Map();
    for (const item of pool) {
      const family = poseFamily(item);
      if (!families.has(family)) families.set(family, []);
      families.get(family).push(item);
    }
    const available = [...families.keys()];
    const total = available.reduce((sum, family) => sum + (weights[family] || 1), 0);
    for (let attempt = 0; attempt < 12; attempt += 1) {
      let cursor = Math.random() * total;
      let family = available[available.length - 1];
      for (const candidateFamily of available) {
        cursor -= weights[candidateFamily] || 1;
        if (cursor <= 0) {
          family = candidateFamily;
          break;
        }
      }
      const candidates = families.get(family) || [];
      const candidate = candidates[Math.floor(Math.random() * candidates.length)];
