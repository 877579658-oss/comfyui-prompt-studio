  function fillSelect(id, items, placeholder) {
    const select = $(id);
    if (!select) return;
    const previous = select.value;
    const hasPlaceholder = placeholder !== undefined;
    const allItems = hasPlaceholder ? [pair(placeholder, ""), ...items] : items;
    const general = allItems.filter((item) => !item.adultOnly);
    const adult = allItems.filter((item) => item.adultOnly);
    select.innerHTML = "";
    const addOption = (parent, item, tagged) => {
      const option = document.createElement("option");
      option.value = item.en;
      option.textContent = tagged ? `·AD ${item.zh}` : item.zh;
      if (Array.isArray(item.aliases) && item.aliases.length) {
        option.dataset.aliases = item.aliases.join(" ");
      }
      parent.append(option);
    };
    // 按 group 归类；没有 group 的排在最前面
    const groups = new Map();
    for (const item of general) {
      const key = item.group || "";
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(item);
    }
    const adultFirst = isAdultScale() && !/OutfitMode$/.test(id);
    const appendAdultGroup = () => {
      if (!adult.length) return;
      if (id === "pose") {
        const intensityOrder = ["suggestive", "boudoir", "adult", "revealing"];
        for (const intensity of intensityOrder) {
          const items = adult.filter((item) => inferredIntensity(item) === intensity);
          if (!items.length) continue;
          const group = document.createElement("optgroup");
          group.label = `${adultGroupLabel()} · ${ADULT_INTENSITY_LABELS[intensity]}`;
          for (const item of items) addOption(group, item, true);
          select.append(group);
        }
