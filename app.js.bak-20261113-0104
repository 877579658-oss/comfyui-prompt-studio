    const total = plans.reduce((sum, item) => sum + (item.plan.weight || 1), 0);
    let cursor = Math.random() * total;
    let picked = plans[plans.length - 1];
    for (const item of plans) {
      cursor -= item.plan.weight || 1;
      if (cursor <= 0) {
        picked = item;
