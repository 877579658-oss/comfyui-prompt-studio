  const SENTENCE_MAX_FIELDS = 8;
  let sentenceSnapshot = null;
  let sentenceTagItems = [];
  let sentenceTagStates = new Map();
  let sentenceLockedFields = new Set();

  function sentenceOption(field, value) {
    if (!FIELD_TO_OPTIONS[field]) return null;
    return getOptionPairs(field).find((item) =>
      item.zh === value ||
      item.en === value ||
      item.promptZh === value ||
      item.promptEn === value
    ) || null;
  }

  function sentenceFieldLabel(field) {
    const wrap = $(field)?.closest("label");
    const span = wrap ? wrap.querySelector("span") : null;
    return span ? span.textContent.trim() : field;
  }

  function sentenceCandidates(text) {
    const lower = String(text || "").trim().toLowerCase();
    if (!lower) return [];
    const picked = new Map();
    const put = (field, en, zh, score, via) => {
      if (!en) return;
      const prev = picked.get(field);
      if (!prev || score > prev.score) picked.set(field, { field, en, zh, score, via });
    };

    // 1) 关键词提示（同义词）
    for (const [re, field, target] of SENTENCE_HINTS) {
      if (!re.test(lower)) continue;
      if (field === "subjectType") {
        put(field, target, target, 100 + String(target).length, "hint");
      } else {
        const item = sentenceOption(field, target);
        if (item) put(field, item.en, item.zh, 100 + item.zh.length, "hint");
      }
    }

    // 2) 字面匹配：整条标签出现在句子里（强），或句子片段出现在标签里（弱，需 >=3 字）
    const grams = new Set();
    for (const run of lower.match(/[\u4e00-\u9fa5]{3,}/g) || []) {
      for (let n = 3; n <= 4; n += 1) {
        for (let i = 0; i + n <= run.length; i += 1) grams.add(run.slice(i, i + n));
      }
    }
    const words = lower.match(/[a-z]{4,}/g) || [];
    for (const field of Object.keys(FIELD_TO_OPTIONS)) {
      if (!fieldAppliesTo(field)) continue;
      if (field.startsWith("second") && currentSubjectType() === "person") continue;
      if (field.startsWith("third") && currentSubjectType() !== "group") continue;
      for (const item of getOptionPairs(field)) {
        if (!item.en || !item.zh) continue;
        if (!optionAllowedAtCurrentScale(item, field)) continue;
        if (lower.includes(item.zh)) {
          put(field, item.en, item.zh, 60 + item.zh.length, "label");
          continue;
        }
        let best = 0;
        let via = "";
        for (const gram of grams) {
          if (item.zh.includes(gram) && gram.length > best) {
            best = gram.length;
            via = gram;
          }
        }
        for (const word of words) {
          if (item.en.toLowerCase().includes(word) && word.length > best) {
            best = word.length;
            via = word;
          }
        }
        if (best >= 3) put(field, item.en, item.zh, best, via);
      }
    }

    // 3) 人数不匹配的不要（单人主体不预填“成对”类选项）
    const subject = picked.get("subjectType")?.en || currentSubjectType();
    const limit = subject === "couple" ? 2 : subject === "group" ? 3 : 1;
    const fits = (item) => {
      const option = sentenceOption(item.field, item.en);
      return !option || (option.people || 1) <= limit;
    };
    let sorted = [...picked.values()].filter(fits).sort((a, b) => b.score - a.score);

    // 4) 弱匹配如果只是被强匹配的片段包含（例如“浅景深背景”里的“浅景深”），丢掉
    const strong = sorted.filter((item) => item.score >= 60);
    sorted = sorted.filter((item) => {
      if (item.score >= 60) return true;
      if (item.zh && item.zh.length > item.score + 1) return false; // 只匹配到标签的一小段，可信度低
      return !strong.some((s) => s.zh && s.zh.includes(item.via));
    });

    const subjectItem = sorted.find((item) => item.field === "subjectType");
    const others = sorted.filter((item) => item.field !== "subjectType");
    const result = subjectItem ? [subjectItem, ...others] : others;
    return result.slice(0, SENTENCE_MAX_FIELDS);
  }

  function detectInputLanguage(text) {
    const value = String(text || "");
    const han = (value.match(/[\u4e00-\u9fa5]/g) || []).length;
    const latinWords = (value.match(/[a-z]+/gi) || []).length;
    if (han >= 2 && (latinWords === 0 || han >= latinWords * 2)) return "zh";
    return "en";
  }

  function renderSentenceChips(items) {
    const root = $("sentenceChips");
    root.innerHTML = "";
    sentenceTagItems = items;
    for (const item of items) {
      const state = sentenceTagStates.get(item.field) || {
        enabled: true,
        manual: false,
        before: sentenceSnapshot ? sentenceSnapshot[item.field] : ""
      };
      sentenceTagStates.set(item.field, state);
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "sentence-chip";
      chip.classList.toggle("removed", !state.enabled);
      chip.title = state.manual
        ? "这一项已手动修改；点击可恢复一句话中的值"
        : state.enabled
          ? "点击取消这一项"
          : "点击恢复一句话中的值";
      const label = sentenceFieldLabel(item.field);
      let valueText = item.zh || item.en;
      if (item.field === "subjectType") {
        const option = [...$("subjectType").options].find((entry) => entry.value === item.en);
        if (option) valueText = option.textContent;
      }
      chip.textContent = `${label} · ${valueText}${state.manual ? "（手动修改）" : state.enabled ? "" : "（已取消）"}`;
      chip.addEventListener("click", () => {
        const tag = sentenceTagStates.get(item.field);
        if (!tag) return;
        if (tag.enabled || tag.manual) {
          const snapshot = tag.before;
          if (item.field === "subjectType") {
            $("subjectType").value = snapshot || "person";
            refreshSelectsForSubject();
          } else {
            setSelectValue(item.field, snapshot || "");
          }
          tag.enabled = false;
          tag.manual = false;
          sentenceLockedFields.delete(item.field);
        } else {
          applySentenceField(item, item.en);
          tag.enabled = true;
          tag.manual = false;
          sentenceLockedFields.add(item.field);
        }
        renderSentenceChips(sentenceTagItems);
        updateVisibility();
        updateOutput();
        saveAutosave();
        renderWizardChecks();
      });
      root.append(chip);
    }
  }

  function applySentenceField(item, value) {
    if (item.field === "subjectType") {
      $("subjectType").value = value || "person";
      refreshSelectsForSubject();
      return;
    }
    setSelectValue(item.field, value || "");
  }

  function reapplySentenceLocks() {
    for (const item of sentenceTagItems) {
      const state = sentenceTagStates.get(item.field);
      if (state?.enabled) applySentenceField(item, item.en);
    }
  }

  function applySentence(items) {
    if (!items.length) return;
    sentenceSnapshot = collectState();
    sentenceTagItems = items;
    sentenceTagStates = new Map(items.map((item) => [item.field, {
      enabled: true,
      manual: false,
      before: sentenceSnapshot[item.field]
    }]));
    sentenceLockedFields = new Set(items.map((item) => item.field));
    primaryLanguage = "en";
    $("language").value = primaryLanguage;
    for (const item of items) {
      applySentenceField(item, item.en);
    }
    if (currentSubjectType() === "person" && $("firstGender").value) {
      setSelectValue("gender", $("firstGender").value);
    }
    ensureRelationshipForSubject();
    syncCharacterPositions();
    resolveConflicts(null);
    if (items.some((item) => item.field === "aspectRatio")) syncSizeFromAspectRatio();
    for (const item of items) noteUserFieldChange(item.field);
    const corrections = resolveConflicts(null, { silent: true });
    reapplySentenceLocks();
    updateVisibility();
    updateOutput();
    saveAutosave();
    renderSentenceChips(items);
    $("sentenceEmpty").hidden = true;
    $("sentenceResult").hidden = false;
    const subjectWarning = sentenceSubjectWarning(items, $("sentenceInput")?.value.trim() || "");
    $("sentenceSummary").textContent = `已应用 ${items.length} 个确定选项；未识别内容未写入，其他字段保留。${subjectWarning ? "主体仍未识别，见下方提示。" : ""}${corrections.length ? `联动修正 ${corrections.length} 项，详见修改记录。` : ""}`;
    if (subjectWarning && !($("sentenceCoverage")?.textContent || "").includes("主体未识别")) {
      $("sentenceCoverage").textContent = `${($("sentenceCoverage")?.textContent || "").trim()}\n${subjectWarning}`.trim();
    }
    $("sentenceApply").disabled = true;
    recordUsabilityChange(sentenceSnapshot, "应用解析选项");

  }

  // 当前主体能容纳的人数上限：单人 1、双人 2、群像不限
  function currentSubjectType() {
    return $("subjectType")?.value || "person";
  }

  function currentRelationshipKey() {
    const item = selectedRawItem("relationshipType");
    if (!item) return "";
    if (item.relationshipKey) return item.relationshipKey;
    const text = `${item.zh} ${item.en}`.toLowerCase();
    if (/单人女性|single adult woman/.test(text)) return "singleFemale";
    if (/单人男性|single adult man/.test(text)) return "singleMale";
    if (/两男一女/.test(text)) return "mmf";
    if (/两女一男/.test(text)) return "ffm";
    if (/多男|three adult men/.test(text)) return "multiMale";
    if (/多女|three adult women/.test(text)) return "multiFemale";
    if (/男男|two adult men/.test(text)) return "mm";
    if (/女女|two adult women/.test(text)) return "ff";
    if (/男女|woman and.*man|man and.*woman/.test(text)) return "mf";
    if (/搭档|partners/.test(text)) return "pair";
    if (/朋友|friends/.test(text)) return "friends";
    if (/混合/.test(text)) return "mixed";
    return "";
  }

  function itemHasRelationshipTags(items) {
    return items.some((item) => Array.isArray(item.relationships) && item.relationships.length);
  }

  function applyRelationshipType({ syncGender = true } = {}) {
    const item = selectedRawItem("relationshipType");
    if (!item) return;
    if (item.subjectType && $("subjectType").value !== item.subjectType) {
      $("subjectType").value = item.subjectType;
    }
    refreshSelectsForSubject();
    if (syncGender && item.gender) setSelectValue("gender", item.gender);
    if (syncGender) syncCharacterGenders(item.relationshipKey || currentRelationshipKey());
    refreshSelectsForSubject();
    syncCharacterPositions();
    refreshRevealDependents();
    refreshAnatomyDependents();
  }

  function syncCharacterGenders(relationshipKey) {
    const defaults = {
      singleFemale: ["adult woman", "", ""],
      singleMale: ["adult man", "", ""],
      mf: ["adult woman", "adult man", ""],
      mm: ["adult man", "adult man", ""],
      ff: ["adult woman", "adult woman", ""],
      pair: ["adult woman", "adult androgynous person", ""],
      mmf: ["adult man", "adult man", "adult woman"],
      ffm: ["adult woman", "adult woman", "adult man"],
      multiMale: ["adult man", "adult man", "adult man"],
      multiFemale: ["adult woman", "adult woman", "adult woman"],
      friends: ["adult woman", "adult man", "adult androgynous person"],
      mixed: ["adult woman", "adult man", "adult androgynous person"]
    }[relationshipKey];
    if (!defaults) return;
    if (!["pair", "friends", "mixed"].includes(relationshipKey) || !$("firstGender").value) {
      setSelectValue("firstGender", defaults[0]);
    }
    setSelectValue("secondGender", defaults[1]);
    setSelectValue("thirdGender", defaults[2]);
  }

  function syncCharacterPositions() {
    const type = currentSubjectType();
    if (type === "person") {
      setSelectValue("firstPosition", "");
      setSelectValue("secondPosition", "");
      setSelectValue("thirdPosition", "");
      return;
    }
    if (!$("firstPosition").value) setSelectValue("firstPosition", "left foreground");
    if (!$("secondPosition").value) setSelectValue("secondPosition", "right midground");
    if (type === "group" && !$("thirdPosition").value) {
      setSelectValue("thirdPosition", "center background");
    }
    if (type !== "group") setSelectValue("thirdPosition", "");
  }

  function normalizeRelationshipForSubject() {
    const item = selectedRawItem("relationshipType");
    if (!item?.subjectType) return;
    if (item.subjectType === currentSubjectType()) return;
    setSelectValue("relationshipType", "");
  }

  function ensureRelationshipForSubject() {
    const type = currentSubjectType();
    if (!["couple", "group"].includes(type) || $("relationshipType").value) return;
    const target = type === "couple"
      ? "two adult partners"
      : "three consenting adult characters with varied gender presentation";
    setSelectValue("relationshipType", target);
    applyRelationshipType();
  }

  function subjectPeopleLimit() {
    const type = currentSubjectType();
    if (type === "couple") return 2;
    if (type === "group") return 3;
    return 1;
  }

