  function styleThumbHue(style) {
    // 从预设的 palette / outfitColor 文本里提取一个稳定的色调，用于缩略图底色
    const src = `${style.fields?.palette || ""} ${style.fields?.outfitColor || ""}`.toLowerCase();
    const hueMap = [
      [/cream|beige|oat|sand|ivory|white|off-white/, "#e8e2d6"],
      [/pink|rose|peach|blush/, "#f3c8d4"],
      [/red|crimson|scarlet|wine/, "#d96a6a"],
      [/orange|amber|caramel|copper/, "#e0a367"],
      [/gold|yellow|mustard/, "#e6c86a"],
      [/green|mint|sage|olive|emerald/, "#a9c8a0"],
      [/blue|navy|indigo|azure|denim|teal|cyan|turquoise/, "#a9bdd6"],
      [/purple|violet|lavender|lilac|plum/, "#c2b0d6"],
      [/black|dark|charcoal|noir|gothic/, "#4a4a52"],
      [/grey|gray|silver|white/, "#c9c9cf"],
      [/brown|tan|coffee|chocolate|earth|autumn/, "#c4a27a"]
    ];
    for (const [re, color] of hueMap) if (re.test(src)) return color;
    return "#d9d4c9";
  }

  function renderQuickStyleChips() {
    const root = $("quickStyleChips");
    if (!root) return;
    root.innerHTML = "";
    const current = $("stylePreset")?.value || "";
    for (const key of QUICK_STYLE_KEYS) {
      const style = STYLE_PRESETS[key];
      if (!style) continue;
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = `quick-style-chip${current === key ? " is-active" : ""}`;
      chip.title = `${style.promptZh || ""}｜单击直接套用，Alt+单击仅选入`;
      const thumb = document.createElement("span");
      thumb.className = "quick-style-thumb";
      thumb.style.setProperty("--thumb-hue", styleThumbHue(style));
      thumb.setAttribute("aria-hidden", "true");
      const name = document.createElement("strong");
      name.textContent = style.zh;
      const group = document.createElement("small");
      group.textContent = style.group || "";
      const hint = document.createElement("em");
      hint.textContent = style.promptEn ? style.promptEn.split(",")[0] : "";
      chip.append(thumb, name, group, hint);
      chip.addEventListener("click", (event) => {
        // Alt / Ctrl / Meta + 单击 = 仅选入（保留原来的两步流程），普通单击 = 直接套用
        if (event.altKey || event.ctrlKey || event.metaKey) {
          pickQuickStyle(key);
        } else {
          pickQuickStyle(key);
          applyQuickSelection();
          setStyleInspire(false);
        }
      });
      root.append(chip);
    }
    const count = $("quickExtrasCount");
    if (count) count.textContent = `${Object.keys(STYLE_PRESETS).length} 个风格可选`;
  }

